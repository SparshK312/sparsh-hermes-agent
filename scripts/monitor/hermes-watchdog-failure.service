[Unit]
Description=Alert that the Hermes watchdog itself failed
Documentation=https://github.com/SparshK312/sparsh-hermes-agent

[Service]
Type=oneshot
# Without this, a crashed/killed watchdog is indistinguishable from a healthy
# system — the documented contract is "silence = healthy", which is only true
# if a broken watchdog can still speak.
# The script inspects real unit state and composes the message from it, so a
# manual invocation of this unit cannot claim a failure that did not occur.
ExecStart=/usr/local/bin/hermes_watchdog.sh --alert "triggered by OnFailure= on hermes-watchdog.service. Check: systemctl status hermes-watchdog.service"
TimeoutStartSec=60
