<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sparsh.hermes-deadman</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>
  <!-- Every 15 min. Two consecutive misses (30 min) before it alerts, so a
       single wifi drop or a laptop-lid close cannot page him. -->
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/sparshk/.hermes/logs/vps-deadman.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/sparshk/.hermes/logs/vps-deadman.launchd.log</string>
</dict>
</plist>
